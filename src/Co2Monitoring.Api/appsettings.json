{
  "ConnectionStrings": {
    "Default": "Data Source=co2monitoring.db"
  },
  "AnomalyDetection": {
    "Validation": {
      "MinEnergyKwh": 0,
      "MinCo2Kg": 0
    },
    "Intensity": {
      "MinKgPerKwh": 0.05,
      "MaxKgPerKwh": 0.50
    },
    "Stats": {
      "LookbackMonths": 3,
      "EnergyMomChangePercent": 50,
      "EnergyVsAvgPercent": 80,
      "Co2MomChangePercent": 50,
      "Co2VsAvgPercent": 80,
      "IntensityVsAvgPercent": 40
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
